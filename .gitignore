e2e/.auth/

# OGTE dataset (data files only — scripts are committed)
data_preparation/ogte-dataset/data/

# Local generator artifacts (exist only on machines that ran the scripts)
scripts/voice-samples/
scripts/tts-samples/
scripts/_tmp-tagalog-sample.ts
tagalog-sample/

# Capacitor-generated nested ignore files (recreated by cap sync)
android/.gitignore
android/app/.gitignore
ios/.gitignore
ios/App/CapApp-SPM/.gitignore

.claude/scheduled_tasks.lock

# Local Claude Code worktrees — never commit
.claude/worktrees/

# Machine-local Claude Code permission approvals (one-shot absolute-path rules;
# project-generic rules live in the tracked .claude/settings.json)
.claude/settings.local.json
native/shell/app-url.js

# Kanban Markdown extension — local task board (see LachyFS.kanban-markdown)
/.devtool

# Cursor editor state / debug artifacts — never commit
/.cursor/

# User-feedback response packages (email drafts + voice samples) — never commit
/feedback/

# Kanban board — symlink into Paul's Obsidian vault (machine-specific path,
# see CLAUDE.md). Recreate with:
# ln -s "$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/PaulsVault/projects/Flexling" board
/board
store-assets/
