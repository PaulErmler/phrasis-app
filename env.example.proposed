# Flexling environment variables
# ==============================
# Copy to .env.local to start: `cp .env.example .env.local` — then fill in what
# you need. All values here are intentionally empty; never commit real values.
#
# Two scopes are mixed in this catalogue, marked per section/variable:
#   [.env.local]  read on this machine by Next.js, the Convex CLI, or scripts
#   [convex env]  must live on the Convex deployment — set with
#                 `npx convex env set NAME value` (putting these in .env.local
#                 does NOT reach the Convex backend; they are listed for
#                 completeness)

# -----------------------------------------------------------------------------
# Convex — REQUIRED for `pnpm dev` [.env.local]
# -----------------------------------------------------------------------------
# Cloud dev deployment name (dev:...). Written by `npx convex dev` on first run;
# also read by e2e/deployment-guard.ts to refuse running e2e against prod.
CONVEX_DEPLOYMENT=
# Deployment client URL (https://<name>.convex.cloud). Required — lib/env.ts
# throws when missing.
NEXT_PUBLIC_CONVEX_URL=
# Deployment HTTP-actions URL (https://<name>.convex.site), used for auth
# routes. Required — lib/env.ts throws when missing.
NEXT_PUBLIC_CONVEX_SITE_URL=
# Self-hosted alternative (docker-compose.yml backend): the Convex CLI uses
# these instead of CONVEX_DEPLOYMENT. Admin key comes from
# `docker compose exec backend ./generate_admin_key.sh`.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# -----------------------------------------------------------------------------
# Auth / OAuth
# -----------------------------------------------------------------------------
# Public origin of the app (http://localhost:3000 in dev). REQUIRED on the
# Convex deployment — convex/auth.ts throws at load without it [convex env].
# The Next app also reads it at build time for canonical URLs / sitemap,
# falling back to https://flexling.com [.env.local, optional].
SITE_URL=
# Secret for the Better Auth component (@convex-dev/better-auth) [convex env].
BETTER_AUTH_SECRET=
# Google OAuth web client (convex/auth.ts socialProviders.google) [convex env].
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple [convex env] — optional: the provider is only registered
# when all four APPLE_* values are set (convex/auth.ts).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Audience of identity tokens minted by the native iOS app; defaults to
# com.flexling.app (convex/auth.ts) [convex env, optional].
APPLE_APP_BUNDLE_IDENTIFIER=
# Native Google Sign-In client IDs for the Capacitor shell
# (components/auth/NativeSocialButtons.tsx) [.env.local, build-time, optional].
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# -----------------------------------------------------------------------------
# Billing — Autumn / Stripe
# -----------------------------------------------------------------------------
# Autumn secret API key (convex/usage/*) [convex env]. Throws at call time when
# missing — billing, quotas, and feature gating need it.
AUTUMN_SECRET_KEY=
# 'true' switches the app to Autumn Managed Payments flows
# (lib/autumn/managed-payments.ts; server/build-time) [.env.local, optional].
AUTUMN_MANAGED_PAYMENTS=
# Stripe TEST-mode secret key (sk_test_...) for the billing-clock e2e specs
# (e2e/stripe-clock.ts) [.env.local, optional — falls back to scanning
# .env.local for any test key].
STRIPE_TEST_SECRET_KEY=
# Stripe secret key for scripts/provisionPastDue.mjs (one-off past-due fixture
# provisioning) [.env.local, optional].
STRIPE_SECRET_KEY=

# -----------------------------------------------------------------------------
# LLM / TTS / STT providers [convex env]
# -----------------------------------------------------------------------------
# OpenRouter API key — powers LLM translation (convex/features/translationLLM.ts),
# the chat agent, writing feedback, TTS semantic validation, and Gemini/MiniMax
# TTS. Content-generation features throw or degrade without it. Also read from
# .env.local by scripts/generate-landing-audio.mts.
OPENROUTER_API_KEY=
# Google Cloud TTS key — Chirp3 voices (convex/lib/tts/google.ts; also
# tests/integration/google-voices.test.ts).
GOOGLE_TTS_API_KEY=
# Google Translate v2 REST fallback key (convex/features/translation.ts; also
# tests/integration/google-translate-fallback.test.ts).
GOOGLE_TRANSLATE_API_KEY=
# Google service-account JSON for Translate v3 (convex/features/translation.ts).
GOOGLE_SERVICE_ACCOUNT_KEY=
# Azure Speech-to-Text (convex/lib/stt/azure.ts; also the landing-audio
# script). The Azure TTS fallback is dormant but kept.
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=

# -----------------------------------------------------------------------------
# Email [convex env]
# -----------------------------------------------------------------------------
# Resend API key for the @convex-dev/resend component (auth + product emails;
# see the note in convex/convex.config.ts).
RESEND_API_KEY=
# Non-prod label ('staging', ...) prefixed to outgoing email subjects
# (convex/lib/emailEnv.ts); empty or 'production' means no prefix. Optional.
EMAIL_ENV=

# -----------------------------------------------------------------------------
# PostHog analytics
# -----------------------------------------------------------------------------
# Browser project API key (lib/posthog/hosts.ts) [.env.local, build-time].
# Analytics are simply off when unset.
NEXT_PUBLIC_POSTHOG_KEY=
# Ingest host override; defaults to the EU ingest host (lib/posthog/hosts.ts)
# [.env.local, optional].
NEXT_PUBLIC_POSTHOG_HOST=
# Personal API key + project id for source-map upload during `next build`
# (next.config.ts) [.env.local/CI, optional — without them builds still work,
# stack traces just stay minified].
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# Server-side project token for the @posthog/convex component — required by
# convex/convex.config.ts [convex env].
POSTHOG_PROJECT_TOKEN=
# Optional host override for the component [convex env].
POSTHOG_HOST=

# -----------------------------------------------------------------------------
# E2E / testing
# -----------------------------------------------------------------------------
# '1' enables the test-only Convex hooks (convex/lib/testHooks.ts) and e2e
# quota grants (convex/usage/helpers.ts). Required on the dev deployment to run
# the e2e suites; never set it in prod [convex env].
E2E_TEST_HOOKS=
# Playwright base URL; defaults to http://localhost:3000 (playwright.config.ts)
# [.env.local, optional].
E2E_BASE_URL=
# '1' keeps the e2e fixture users after a run (e2e/global-teardown.ts)
# [.env.local, optional].
E2E_SKIP_USER_CLEANUP=

# -----------------------------------------------------------------------------
# Feature flags / debug knobs [optional]
# -----------------------------------------------------------------------------
# Dataset-cutover switch read by convex/admin/activateDataset.ts [convex env].
FF_NEW_COURSE_CUTOVER=
# App-update-gate debugging (components/app/AppUpdateGate.tsx): set
# NEXT_PUBLIC_UPDATE_DEBUG=1 plus optional timing overrides [.env.local].
NEXT_PUBLIC_UPDATE_DEBUG=
NEXT_PUBLIC_UPDATE_HIDDEN_MS=
NEXT_PUBLIC_UPDATE_ESCALATE_MS=
# Fake build id served by /api/version while NEXT_PUBLIC_UPDATE_DEBUG=1
# (app/api/version/route.ts) [.env.local].
DEV_BUILD_ID=
# '1' exposes the /screenshots capture routes in production builds
# (app/screenshots/[screen]/page.tsx) [.env.local].
ENABLE_STORE_SCREENS=
# Target origin for scripts/store-screenshots.ts; defaults to
# http://localhost:3000 [.env.local].
BASE_URL=
# Capacitor native-shell dev server mode: 'local' or 'dev'
# (capacitor.config.ts, set via scripts/cap-sync.mjs) [.env.local].
CAP_SERVER=

# -----------------------------------------------------------------------------
# Set by the platform / tooling — do NOT put these in .env.local
# -----------------------------------------------------------------------------
# BUILD_ID, SOURCE_COMMIT, VERCEL_GIT_COMMIT_SHA, VERCEL_DEPLOYMENT_ID
#   — host-announced commit identity, read by scripts/build-id.mjs at build time.
# NEXT_PUBLIC_BUILD_ID, NEXT_PUBLIC_BUILD_ID_SOURCE
#   — injected by next.config.ts from the generated .build-id.json.
# NODE_ENV, NEXT_RUNTIME, CI — set by Next.js / the test runners / CI.
