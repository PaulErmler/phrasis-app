{
  "name": "flexling-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "DATABASE_UDF_USER_TIMEOUT_SECONDS=10 DATABASE_UDF_SYSTEM_TIMEOUT_SECONDS=30 APPLICATION_MAX_CONCURRENT_QUERIES=64 APPLICATION_MAX_CONCURRENT_MUTATIONS=64 APPLICATION_MAX_CONCURRENT_V8_ACTIONS=64 APPLICATION_MAX_CONCURRENT_NODE_ACTIONS=64 convex dev",
    "predev": "convex dev --until-success",
    "build": "node scripts/build-id.mjs && next build",
    "build:deploy": "convex deploy --cmd 'pnpm run build' && convex run migrations:runAll --prod",
    "start": "next start",
    "seed-texts": "node scripts/uploadTexts.mjs",
    "update-translations": "node scripts/updateTranslations.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:convex": "vitest run --project=convex",
    "test:app": "vitest run --project=app",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:billing": "playwright test --project billing-live --project payment-overdue --project billing-clock --no-deps",
    "lint": "eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "format": "prettier --write .",
    "lint:staged": "lint-staged",
    "prepare": "husky install",
    "snapshot": "mkdir -p .convex-snapshots && convex export --env-file .env.local --path .convex-snapshots/$(git rev-parse --abbrev-ref HEAD | tr '/' '_').zip && echo '[convex] Snapshot saved.'",
    "snapshot:restore": "convex import --replace -y --env-file .env.local .convex-snapshots/$(git rev-parse --abbrev-ref HEAD | tr '/' '_').zip",
    "landing:audio": "tsx --env-file=.env.local scripts/generate-landing-audio.mts",
    "store:assets": "tsx scripts/store-screenshots.ts",
    "cap:local": "node scripts/cap-sync.mjs local",
    "cap:dev": "node scripts/cap-sync.mjs dev",
    "cap:store": "node scripts/cap-sync.mjs store"
  },
