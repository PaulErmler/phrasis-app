{
  "name": "flexling-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success",
    "build": "next build",
    "start": "next start",
    "seed-texts": "node scripts/uploadTexts.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs",
    "lint:fix": "prettier --write . && eslint . --ext .js,.jsx,.ts,.tsx,.mjs --fix",
    "format": "prettier --write .",
    "lint:staged": "lint-staged",
    "prepare": "husky install",
    "snapshot": "mkdir -p .convex-snapshots && convex export --env-file .env.local --path .convex-snapshots/$(git rev-parse --abbrev-ref HEAD | tr '/' '_').zip && echo '[convex] Snapshot saved.'",
    "snapshot:restore": "convex import --replace -y --env-file .env.local .convex-snapshots/$(git rev-parse --abbrev-ref HEAD | tr '/' '_').zip"
  },
  "dependencies": {
